{% sw_extends '@Storefront/storefront/element/cms-element-product-description-reviews.html.twig' %}

{% block element_product_description_reviews_tabs_navigation_review %}
    {{ parent() }}
    {% set notice = mgd_eu_notice(context) %}
    {% if notice.enabled and notice.productTab %}
        <li class="nav-item">
            <a class="nav-link product-detail-tab-navigation-link"
               id="mgd-guarantee-tab-{{ element.id }}"
               data-bs-toggle="tab" data-off-canvas-tabs="true"
               href="#mgd-guarantee-pane-{{ element.id }}"
               role="tab" aria-controls="mgd-guarantee-pane-{{ element.id }}" aria-selected="false">
                {{ notice.linkText }}
                <span class="product-detail-tab-navigation-icon">{% sw_icon 'arrow-medium-right' style {'pack':'solid'} %}</span>
            </a>
        </li>
    {% endif %}
{% endblock %}

{% block element_product_description_reviews_tabs_content_review %}
    {{ parent() }}
    {% set notice = mgd_eu_notice(context) %}
    {% if notice.enabled and notice.productTab %}
        <div class="tab-pane fade" id="mgd-guarantee-pane-{{ element.id }}"
             role="tabpanel" aria-labelledby="mgd-guarantee-tab-{{ element.id }}">
            {% sw_include '@MgdEuLabel/storefront/component/mgd-eu-label/product-content.html.twig' %}
        </div>
    {% endif %}
{% endblock %}
